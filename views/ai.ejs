<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatGPT Clone</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-white">
    <div class="relative flex h-screen">
        <!-- Sidebar -->
        <div id="sidebar"
            class="w-64 bg-gray-800 p-4 overflow-y-auto fixed left-0 top-0 h-full transform -translate-x-full transition-transform duration-300 z-10">
            <div class="flex justify-between items-center">
                <h2 class="text-lg font-bold">Repositories</h2>
                <button onclick="toggleSidebar()" class="text-xl">✖</button>
            </div>
            <button onclick="createNewRepo()" class="w-full p-2 my-2 bg-green-600 rounded">+ New Repo</button>
            <div id="repoList" class="mt-2"></div>
        </div>

        <!-- Main Content -->
        <div id="mainContent" class="flex-1 flex flex-col ml-0 w-full transition-all duration-300">
            <!-- Top Bar -->
            <div class="p-4 bg-gray-800 flex justify-between items-center z-20 relative">
                <button onclick="toggleSidebar()" class="text-lg text-white hover:text-gray-300 focus:outline-none">
                    ☰
                </button>
                <h1 class="text-xl font-bold text-white">It's only your AI</h1>
                <div class="flex space-x-4">
                    <button onclick="deleteCurrentRepo()"
                        class="bg-red-500 p-2 rounded hover:bg-red-600 transition duration-200 ease-in-out ">
                        Delete Repo
                    </button>
                    <form action="/logout" method="post">
                        <button type="submit"
                            class="bg-yellow-500 p-2 rounded hover:bg-yellow-600 transition duration-200 ease-in-out">
                            Logout
                        </button>
                    </form>
                </div>
            </div>


            <!-- Chat Section -->
            <div id="chatBox" class="flex-1 p-4 overflow-y-auto mt-2 overflow-x-hidden"></div>

            <!-- Input Form -->
            <form onsubmit="handleFormSubmit(event)" class="p-4 bg-gray-800 flex">
                <input type="text" id="prompt" class="flex-1 p-2 text-black" placeholder="Type your message..."
                    required>
                <button type="submit" class="p-2 bg-blue-500 ml-2">Send</button>
            </form>
        </div>
    </div>

    <script>
        let repositories = JSON.parse(localStorage.getItem("repositories")) || [{ name: "Default Repo", chats: [] }];
        let currentRepoIndex = 0;
        let message;
        document.addEventListener("DOMContentLoaded", () => {
            updateRepoList();
            loadChat();
        });

        function handleFormSubmit(event) {
            event.preventDefault();
            const promptInput = document.getElementById('prompt');
            message = promptInput.value.trim();
            if (!message) return;

            addMessage("user", message);

            fetch('/ai', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ prompt: message })
            })
                .then(res => res.json())
                .then(data => {
                    addMessage("ai", data.response);
                })
                .catch(err => {
                    addMessage("ai", "Error fetching response");
                });

            promptInput.value = "";
        }

        function addMessage(sender, text) {
            const chatBox = document.getElementById('chatBox');
            let formattedText = text.includes("\n") ? `<pre class=' bg-sky-500/40 p-6 rounded break-words whitespace-pre-wrap'>${text}</pre>` : `<p>${text}</p>`;
            chatBox.innerHTML += `<div class='mb-2 p-2 ${sender === "user" ? "text-right" : "text-left"} max-w-full break-words whitespace-pre-wrap overflow-hidden'>${formattedText}</div>`;
            chatBox.scrollTop = chatBox.scrollHeight;

            repositories[currentRepoIndex].chats.push({ sender, text });
            localStorage.setItem("repositories", JSON.stringify(repositories));
        }

        function loadChat() {
            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML = "";
            repositories[currentRepoIndex].chats.forEach(chat => {
                addMessage(chat.sender, chat.text);
            });
        }

        function updateRepoList() {
            const repoList = document.getElementById('repoList');
            repoList.innerHTML = "";
            repositories.forEach((repo, index) => {
                repoList.innerHTML += `
                    <div class="flex justify-between items-center p-2 my-1 bg-gray-700 rounded">
                        <button onclick='switchRepo(${index})' class="flex-1 text-left">${repo.name}</button>
                        <button onclick='deleteRepo(${index})' class="text-red-500 ml-2">Delete</button>
                    </div>
                `;
            });
        }

        function createNewRepo() {
            const repoName = prompt("Enter you repo name")
            repositories.push({ name: repoName, chats: [] });
            localStorage.setItem("repositories", JSON.stringify(repositories));
            updateRepoList();
        }

        function switchRepo(index) {
            currentRepoIndex = index;
            loadChat();
        }

        function deleteRepo(index) {
            repositories.splice(index, 1);
            if (currentRepoIndex === index) { currentRepoIndex = 0; }
            localStorage.setItem("repositories", JSON.stringify(repositories));
            updateRepoList();
            loadChat();
        }

        function deleteCurrentRepo() {
            repositories.splice(currentRepoIndex, 1);
            currentRepoIndex = 0;
            localStorage.setItem("repositories", JSON.stringify(repositories));
            updateRepoList();
            loadChat();
        }

        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const mainContent = document.getElementById("mainContent");

            // Toggle sidebar visibility
            sidebar.classList.toggle("-translate-x-full");

            // Set the main content margin based on sidebar visibility
            if (sidebar.classList.contains("-translate-x-full")) {
                mainContent.style.marginLeft = "0";  // Sidebar closed, reset margin
            } else {
                mainContent.style.marginLeft = "256px";  // Sidebar open, shift content
            }
        }

    </script>
</body>

</html>