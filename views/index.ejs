<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon"  href="https://th.bing.com/th/id/OIP.tZQ8CWUtoT0VA28qAAvyrQHaGh?rs=1&pid=ImgDetMain">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LOGIN</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="bg-black flex items-center justify-center min-h-screen p-4">
    <div class="bg-gray-900 p-6 md:p-8 rounded-lg shadow-lg border border-green-700 w-full max-w-sm md:max-w-md">
        <h1 class="text-2xl md:text-3xl font-bold text-center text-green-400 mb-6">🔒 Login</h1>

        <form action="/login" method="post">
            <div class="mb-4">
                <label for="name" class="block text-green-300 mb-1">Username</label>
                <input type="text" name="name" id="name"
                    class="w-full px-3 py-3 border border-green-600 rounded bg-black text-white focus:ring-2 focus:ring-green-500 outline-none transition-all placeholder-gray-500"
                    placeholder="Enter your username">
            </div>

            <div class="mb-6">
                <label for="password" class="block text-green-300 mb-1">Password</label>
                <input type="password" name="password" id="password"
                    class="w-full px-3 py-3 border border-green-600 rounded bg-black text-white focus:ring-2 focus:ring-green-500 outline-none transition-all placeholder-gray-500"
                    placeholder="Enter your password">
            </div>

            <button type="submit"
                class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-md font-semibold transition-all shadow-md">
                Login
            </button>
        </form>
    </div>
</body>


</html>